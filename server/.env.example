# Copy to .env and edit.
# Your free DuckDNS name (or any domain pointing at this server). Caddy gets the certificate for it.
DOMAIN=quran-glasses.duckdns.org
# Shared secret the app must send. Choose something long and random.
ASR_TOKEN=change-me-to-a-long-random-string
# Quran-tuned Whisper model (Apache-2.0). whisper-tiny-ar-quran is faster but less accurate.
ASR_MODEL_ID=tarteel-ai/whisper-base-ar-quran
# CPU threads for decoding (Oracle A1.Flex with 4 OCPU: 4)
ASR_THREADS=4
